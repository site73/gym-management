# 复制为 .env 后填写；.env 不纳入版本库（含密钥）
# 注意：数据库不对外开放端口，此处 IP 仅为容器内网

# 运行环境：dev / pilot / prod
APP_PROFILE=pilot

# 数据库
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=gym
MYSQL_USER=gym_app
MYSQL_PASSWORD=change-me-app

# 微信小程序与支付（对应待关闭问题 Q9）
WECHAT_APPID=
WECHAT_SECRET=
WXPAY_MCHID=
WXPAY_KEY=

# 提醒通道（对应待关闭问题 Q10）：wx_subscribe 或 sms
NOTIFY_CHANNEL=wx_subscribe

# 备份保留天数
BACKUP_KEEP_DAYS=14
